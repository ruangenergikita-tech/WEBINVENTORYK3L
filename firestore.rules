rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function diizinkan() {
      return request.auth != null
        && request.auth.token.email in [
          'ruangenergikita@gmail.com',
          'k3lplnup2d@gmail.com'
        ];
    }
    match /p3k/{id}    { allow read, write: if diizinkan(); }
    match /apar/{id}   { allow read, write: if diizinkan(); }
    match /barang/{id} { allow read, write: if diizinkan(); }
  }
}
